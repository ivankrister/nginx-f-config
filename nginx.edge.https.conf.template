# Nginx proxy cache configuration
proxy_cache_path /var/cache/nginx/hls_cache levels=1:2 keys_zone=hls_cache:100m max_size=10g inactive=24h use_temp_path=off;
proxy_cache_path /var/cache/nginx/general_cache levels=1:2 keys_zone=general_cache:50m max_size=2g inactive=12h use_temp_path=off;

upstream edge_go_backend {
    server edge-go:9000;
    keepalive 32;
}

# Cache key for HLS content
map $request_uri $hls_cache_key {
    default "$scheme$proxy_host$request_uri";
}

server {
    listen 80;
    listen [::]:80;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $DEFAULT_SERVER_NAMES;

    ssl_certificate /etc/nginx/keys/server.crt;
    ssl_certificate_key /etc/nginx/keys/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    send_timeout 10s;
    
    # Add cache status header
    add_header X-Cache-Status $upstream_cache_status always;

    location /up {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

     location /bestdashboard {
        proxy_pass http://edge_go_backend/dashboard;
        proxy_buffering off;
    }


    location = /apl {
        return 403;
    }

    location ^~ /apl/ {
        return 403;
    }
    location /dashboard/ {
        return 403;
    }

    location / {
        proxy_pass http://edge_go_backend;
        
        # Enable general caching
        proxy_cache general_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 5s;
        proxy_cache_valid 404 30s;
        proxy_cache_use_stale error timeout updating;
        
        proxy_buffering on;
    }

    error_log /dev/stderr warn;
    access_log /dev/stdout;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name $APL_SERVER_NAMES;

    ssl_certificate /etc/nginx/keys/apl.crt; # cert for apl domain
    ssl_certificate_key /etc/nginx/keys/apl.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    
    # Add cache status header
    add_header X-Cache-Status $upstream_cache_status always;

    # APL playlists - 1s cache
    location ~ ^/(.*\.m3u8)$ {
        proxy_pass http://edge_go_backend/apl/stream/streams/$1;
        
        proxy_cache hls_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 5s;
        proxy_cache_use_stale error timeout updating;
        proxy_buffering on;
    }
    
    # APL segments - 30s cache
    location ~ ^/(.*\.ts)$ {
        proxy_pass http://edge_go_backend/apl/stream/streams/$1;
        
        proxy_cache hls_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 30s;
        proxy_cache_use_stale error timeout updating;
        proxy_buffering on;
    }
    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    send_timeout 10s;

    location ~ ^/(.*\.(m3u8|ts))$ {
        proxy_pass http://edge_go_backend/apl/stream/streams/$1;
        proxy_buffering off;
    }
    location = /apl {
        return 403;
    }

    location ^~ /apl/ {
        return 403;
    }
    location / {
        return 403;
    }
    error_log /dev/stderr warn;
    access_log /dev/stdout;
}
