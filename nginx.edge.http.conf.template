# Nginx proxy cache configuration
proxy_cache_path /var/cache/nginx/hls_cache levels=1:2 keys_zone=hls_cache:100m max_size=10g inactive=24h use_temp_path=off;
proxy_cache_path /var/cache/nginx/general_cache levels=1:2 keys_zone=general_cache:50m max_size=2g inactive=12h use_temp_path=off;

upstream edge_go_backend {
    server edge-go:9000;
    keepalive 32;
}

# Cache key for HLS content
map $request_uri $hls_cache_key {
    default "$scheme$proxy_host$request_uri";
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 3s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    send_timeout 10s;
    
    # Add cache status header
    add_header X-Cache-Status $upstream_cache_status always;

    location /up {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # APL HLS content with aggressive caching
    location ~ /(.*\.(m3u8))$ {
        proxy_pass http://edge_go_backend/apl/stream/streams/$1;
        
        # Enable caching for playlists
        proxy_cache hls_cache;
        proxy_cache_key $hls_cache_key;
        proxy_cache_valid 200 1s;
        proxy_cache_valid 404 10s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        
        # Respect backend cache headers
        proxy_cache_revalidate on;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }
    
    location ~ /(.*\.(ts))$ {
        proxy_pass http://edge_go_backend/apl/stream/streams/$1;
        
        # Enable aggressive caching for segments
        proxy_cache hls_cache;
        proxy_cache_key $hls_cache_key;
        proxy_cache_valid 200 5m;
        proxy_cache_valid 404 1m;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 8 128k;
    }

    location / {
        proxy_pass http://edge_go_backend;
        
        # Enable general caching for other content
        proxy_cache general_cache;
        proxy_cache_key "$scheme$proxy_host$request_uri";
        proxy_cache_valid 200 5s;
        proxy_cache_valid 404 30s;
        proxy_cache_use_stale error timeout updating;
        
        proxy_buffering on;
    }

    error_log /dev/stderr warn;
    access_log /dev/stdout;
}
